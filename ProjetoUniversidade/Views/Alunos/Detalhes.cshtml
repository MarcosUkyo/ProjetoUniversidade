@model ProjetoUniversidade.Models.Aluno
@{ ViewData["Title"] = "Detalhes do Aluno"; }
<div class="page-header"><h1>Aluno</h1></div>
<div class="card" style="max-width:500px">
    <dl class="details">
        <dt>RA</dt><dd><span class="badge badge-info">@Model.Ra</span></dd>
        <dt>Nome</dt><dd>@Model.Nome</dd>
        <dt>CPF</dt><dd>@Model.Cpf</dd>
        <dt>Data de Ingresso</dt><dd>@Model.DataIngresso.ToString("dd/MM/yyyy")</dd>
    </dl>
    <div class="form-actions">
        <a asp-action="Editar" asp-route-id="@Model.IdAluno" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-light">Voltar</a>
    </div>
</div>