@model ProjetoUniversidade.Models.Professor
@{ ViewData["Title"] = "Novo Professor"; }

<div class="page-header"><h1>Novo Professor</h1></div>
<div class="card" style="max-width:600px">
    <form asp-action="Criar" method="post">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div class="field" style="grid-column: span 2">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="input" placeholder="Nome completo" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Cpf"></label>
                <input asp-for="Cpf" class="input" placeholder="Somente números (11 dígitos)" maxlength="11" />
                <span asp-validation-for="Cpf" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Titulacao"></label>
                <select asp-for="Titulacao" class="select">
                    <option value="">(Selecione)</option>
                    <option value="Graduado">Graduado</option>
                    <option value="Especialista">Especialista</option>
                    <option value="Mestre">Mestre</option>
                    <option value="Doutor">Doutor</option>
                    <option value="Pós-Doutor">Pós-Doutor</option>
                </select>
                <span asp-validation-for="Titulacao" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="IdDepto">Departamento</label>
                <select asp-for="IdDepto" asp-items="ViewBag.Departamentos" class="select">
                    <option value="">(Selecione)</option>
                </select>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a asp-action="Index" class="btn btn-light">Cancelar</a>
        </div>
    </form>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }