@model ProjetoUniversidade.Models.Disciplina
@{ ViewData["Title"] = "Detalhes da Disciplina"; }
<div class="page-header"><h1>Disciplina</h1></div>
<div class="card" style="max-width:500px">
    <dl class="details">
        <dt>Código</dt><dd><span class="badge badge-info">@Model.Codigo</span></dd>
        <dt>Nome</dt><dd>@Model.Nome</dd>
        <dt>Carga Horária</dt><dd>@Model.CargaHoraria horas</dd>
        <dt>Departamento</dt><dd>@(Model.DeptoNome ?? "-")</dd>
    </dl>
    <div class="form-actions">
        <a asp-action="Editar" asp-route-id="@Model.IdDisciplina" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-light">Voltar</a>
    </div>
</div>