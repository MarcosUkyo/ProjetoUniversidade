@model IEnumerable<ProjetoUniversidade.Models.Turma>
@{ ViewData["Title"] = "Turmas"; }

<div class="page-header">
    <h1>Turmas</h1>
    <a asp-action="Criar" class="btn btn-primary">+ Nova Turma</a>
</div>
<div class="card">
    <table class="tbl">
        <thead><tr><th>Semestre</th><th>Disciplina</th><th>Professor</th><th>Ações</th></tr></thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td><span class="badge badge-info">@t.Semestre</span></td>
                <td>@(t.DisciplinaCodigo ?? "") – @(t.DisciplinaNome ?? "-")</td>
                <td>@(t.ProfessorNome ?? "-")</td>
                <td>
                    <a asp-action="Detalhes" asp-route-id="@t.IdTurma" class="btn btn-light btn-sm">Ver</a>
                    <a asp-action="Editar"   asp-route-id="@t.IdTurma" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Excluir"  asp-route-id="@t.IdTurma" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="4" style="text-align:center;color:#94a3b8">Nenhuma turma cadastrada.</td></tr> }
        </tbody>
    </table>
</div>