@model ProjetoUniversidade.Models.Turma
@{ ViewData["Title"] = "Nova Turma"; }

<div class="page-header"><h1>Nova Turma</h1></div>
<div class="card" style="max-width:600px">
    <form asp-action="Criar" method="post">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div class="field">
                <label asp-for="Semestre"></label>
                <input asp-for="Semestre" class="input" placeholder="Ex: 2025.1" maxlength="10" />
                <span asp-validation-for="Semestre" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="IdDisciplina">Disciplina</label>
                <select asp-for="IdDisciplina" asp-items="ViewBag.Disciplinas" class="select">
                    <option value="">(Selecione)</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="IdProfessor">Professor</label>
                <select asp-for="IdProfessor" asp-items="ViewBag.Professores" class="select">
                    <option value="">(Selecione)</option>
                </select>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a asp-action="Index" class="btn btn-light">Cancelar</a>
        </div>
    </form>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }