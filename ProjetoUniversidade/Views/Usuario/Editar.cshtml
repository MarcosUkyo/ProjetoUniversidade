@model ProjetoUniversidade.Models.Usuario
@{ ViewData["Title"] = "Editar Usuário"; }

<div class="page-header"><h1>Editar Usuário</h1></div>
<div class="card" style="max-width:500px">
    <form asp-action="Editar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="form-grid">
            <div class="field" style="grid-column:span 2">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="input" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="field" style="grid-column:span 2">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="input" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="field" style="grid-column:span 2">
                <label asp-for="SenhaHash">Nova Senha (deixe em branco para manter)</label>
                <input asp-for="SenhaHash" class="input" type="password" autocomplete="new-password" placeholder="Deixe vazio para não alterar" />
            </div>
            <div class="field">
                <label asp-for="Role"></label>
                <select asp-for="Role" class="select">
                    <option value="Biblioteca">Biblioteca</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <div class="field" style="justify-content:flex-end">
                <label><input asp-for="Ativo" type="checkbox" /> Usuário ativo</label>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a asp-action="Index" class="btn btn-light">Cancelar</a>
        </div>
    </form>
</div>