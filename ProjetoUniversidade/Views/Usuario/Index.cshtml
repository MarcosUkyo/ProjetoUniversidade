@model IEnumerable<ProjetoUniversidade.Models.Usuario>
@{ ViewData["Title"] = "Usuários do Sistema"; }

<div class="page-header">
    <h1>Usuários</h1>
    <a asp-action="Criar" class="btn btn-primary">+ Novo Usuário</a>
</div>
<div class="card">
    <table class="tbl">
        <thead><tr><th>Nome</th><th>E-mail</th><th>Papel</th><th>Status</th><th>Criado em</th><th>Ações</th></tr></thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Nome</td>
                <td>@u.Email</td>
                <td><span class="badge badge-info">@u.Role</span></td>
                <td><span class="badge @(u.Ativo ? "badge-success" : "badge-danger")">@(u.Ativo ? "Ativo" : "Inativo")</span></td>
                <td>@u.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <a asp-action="Detalhes" asp-route-id="@u.Id" class="btn btn-light btn-sm">Ver</a>
                    <a asp-action="Editar"   asp-route-id="@u.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Excluir"  asp-route-id="@u.Id" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="6" style="text-align:center;color:#94a3b8">Nenhum usuário cadastrado.</td></tr> }
        </tbody>
    </table>
</div>