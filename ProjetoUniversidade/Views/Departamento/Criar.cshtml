@model ProjetoUniversidade.Models.Departamento
@{ ViewData["Title"] = "Novo Departamento"; }

<div class="page-header"><h1>Novo Departamento</h1></div>
<div class="card" style="max-width:500px">
    <form asp-action="Criar" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert-error" style="display:none"></div>
        <div class="form-grid">
            <div class="field">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="input" placeholder="Ex: Engenharia de Computação" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Sigla"></label>
                <input asp-for="Sigla" class="input" placeholder="Ex: ENG" maxlength="10" />
                <span asp-validation-for="Sigla" class="text-danger"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a asp-action="Index" class="btn btn-light">Cancelar</a>
        </div>
    </form>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }