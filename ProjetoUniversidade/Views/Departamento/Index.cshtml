@model IEnumerable<ProjetoUniversidade.Models.Departamento>
@using ProjetoUniversidade.Autenticacao
@{ ViewData["Title"] = "Departamentos";
   var _role = Context.Session.GetString(SessionKeys.UserRole);
   bool _gerenciar = _role == "Reitor" || _role == "Gerente"; }

<div class="page-header">
    <h1>Departamentos</h1>
    @if (_gerenciar) { <a asp-action="Criar" class="btn btn-primary">+ Novo Departamento</a> }
</div>
<div class="card">
    <table class="tbl">
        <thead><tr><th>#</th><th>Nome</th><th>Sigla</th><th>Ações</th></tr></thead>
        <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.IdDepto</td>
                <td>@d.Nome</td>
                <td><span class="badge badge-info">@d.Sigla</span></td>
                <td>
                    <a asp-action="Detalhes" asp-route-id="@d.IdDepto" class="btn btn-light btn-sm">Ver</a>
                    @if (_gerenciar) {
                        <a asp-action="Editar"  asp-route-id="@d.IdDepto" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Excluir" asp-route-id="@d.IdDepto" class="btn btn-danger btn-sm">Excluir</a>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="4" style="text-align:center;color:#94a3b8">Nenhum departamento cadastrado.</td></tr> }
        </tbody>
    </table>
</div>