@model ProjetoUniversidade.Models.Departamento
@{ ViewData["Title"] = "Excluir Departamento"; }

<div class="page-header"><h1>Excluir Departamento</h1></div>
<div class="card" style="max-width:500px">
    <div class="alert-error">Tem certeza que deseja excluir este departamento?</div>
    <dl class="details">
        <dt>Nome</dt><dd>@Model.Nome</dd>
        <dt>Sigla</dt><dd>@Model.Sigla</dd>
    </dl>
    <form asp-action="Excluir" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.IdDepto" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
            <a asp-action="Index" class="btn btn-light">Cancelar</a>
        </div>
    </form>
</div>